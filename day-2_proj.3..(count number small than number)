input_nums=[]
result_nums=[]
a=int(input("enter how many number you want to enter"))
for i in range(1,a+1):
    b=int(input(f"enter number {i} :- "))
    input_nums.append(b)

for c in input_nums:
    count=0
    for j in input_nums:
        if j<c:
            count+=1
    result_nums.append(count)
print(result_nums)

